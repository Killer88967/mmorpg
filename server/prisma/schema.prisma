generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Character {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  x         Float    @default(300)
  y         Float    @default(300)
  color     String   @default("#ffffff")
  inventory String   @default("{}")
  tools     String   @default("[]")
  updatedAt DateTime @updatedAt
}

model WorldData {
  id     Int    @id @default(1)
  placed String @default("[]")
  chests String @default("{}")
}